@@ -0,0 +1,37 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>{{ title }} · Shared Conversation</title>
+  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}" />
+</head>
+<body class="share-page">
+  <div class="app share-app">
+    <header class="app-header">
+      <div class="brand">
+        <span class="brand-icon">🎓</span>
+        <div>
+          <h1>{{ title }}</h1>
+          <p>Shared conversation · read-only</p>
+        </div>
+      </div>
+    </header>
+
+    <main class="chat-window">
+      {% for turn in messages %}
+      <div class="message user">
+        <div class="bubble">{{ turn.message }}</div>
+      </div>
+      <div class="message bot">
+        <div class="bubble">{{ turn.response }}</div>
+      </div>
+      {% endfor %}
+    </main>
+
+    <footer class="share-footer">
+      <p>Shared from AI Academic Support Chatbot</p>
+    </footer>
+  </div>
+</body>
+</html>
