diff --git a/templates/login.html b/templates/login.html
new file mode 100644
index 0000000..26a7016
--- /dev/null
+++ b/templates/login.html
@@ -0,0 +1,44 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Log in · AI Academic Support Chatbot</title>
+  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}" />
+</head>
+<body class="auth-page">
+  <div class="auth-card">
+    <div class="brand auth-brand">
+      <span class="brand-icon">🎓</span>
+      <div>
+        <h1>Academic Support Chatbot</h1>
+        <p>Log in to continue your conversations</p>
+      </div>
+    </div>
+
+    {% with messages = get_flashed_messages(with_categories=true) %}
+      {% if messages %}
+      <div class="flash-list">
+        {% for category, message in messages %}
+        <div class="flash flash-{{ category }}">{{ message }}</div>
+        {% endfor %}
+      </div>
+      {% endif %}
+    {% endwith %}
+
+    <form method="post" action="{{ url_for('login_page') }}" class="auth-form">
+      <input type="hidden" name="next" value="{{ next or '' }}" />
+
+      <label for="email">Email</label>
+      <input id="email" name="email" type="email" autocomplete="email" required value="{{ email or '' }}" />
+
+      <label for="password">Password</label>
+      <input id="password" name="password" type="password" autocomplete="current-password" required />
+
+      <button type="submit">Log in</button>
+    </form>
+
+    <p class="auth-switch">Don't have an account? <a href="{{ url_for('signup_page') }}">Sign up</a></p>
+  </div>
+</body>
+</html>
diff --git a/templates/profile.html b/templates/profile.html
new file mode 100644
index 0000000..a32415c
--- /dev/null
+++ b/templates/profile.html
@@ -0,0 +1,52 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Profile · AI Academic Support Chatbot</title>
+  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}" />
+</head>
+<body class="auth-page">
+  <div class="auth-card">
+    <div class="brand auth-brand">
+      <span class="brand-icon">🎓</span>
+      <div>
+        <h1>Profile &amp; settings</h1>
+        <p>Your account details</p>
+      </div>
+    </div>
+
+    {% with messages = get_flashed_messages(with_categories=true) %}
+      {% if messages %}
+      <div class="flash-list">
+        {% for category, message in messages %}
+        <div class="flash flash-{{ category }}">{{ message }}</div>
+        {% endfor %}
+      </div>
+      {% endif %}
+    {% endwith %}
+
+    <dl class="profile-fields">
+      <dt>Username</dt>
+      <dd>{{ user.username }}</dd>
+      <dt>Email</dt>
+      <dd>{{ user.email }}</dd>
+      <dt>Member since</dt>
+      <dd>{{ user.created_at[:10] }}</dd>
+    </dl>
+
+    <p class="profile-note">
+      Password changes and other account settings aren't available yet —
+      this page is a placeholder for that, distinct from the account info
+      above which is fully live.
+    </p>
+
+    <div class="auth-actions">
+      <a class="header-btn" href="{{ url_for('index') }}">Back to chat</a>
+      <form method="post" action="{{ url_for('logout_page') }}">
+        <button type="submit" class="header-btn">Log out</button>
+      </form>
+    </div>
+  </div>
+</body>
+</html>
diff --git a/templates/signup.html b/templates/signup.html
new file mode 100644
index 0000000..b1ad8e5
--- /dev/null
+++ b/templates/signup.html
@@ -0,0 +1,49 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Sign up · AI Academic Support Chatbot</title>
+  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}" />
+</head>
+<body class="auth-page">
+  <div class="auth-card">
+    <div class="brand auth-brand">
+      <span class="brand-icon">🎓</span>
+      <div>
+        <h1>Academic Support Chatbot</h1>
+        <p>Create an account to save your conversations</p>
+      </div>
+    </div>
+
+    {% with messages = get_flashed_messages(with_categories=true) %}
+      {% if messages %}
+      <div class="flash-list">
+        {% for category, message in messages %}
+        <div class="flash flash-{{ category }}">{{ message }}</div>
+        {% endfor %}
+      </div>
+      {% endif %}
+    {% endwith %}
+
+    <form method="post" action="{{ url_for('signup_page') }}" class="auth-form">
+      <label for="username">Username</label>
+      <input id="username" name="username" type="text" autocomplete="username" required
+             minlength="3" maxlength="30" value="{{ username or '' }}" />
+
+      <label for="email">Email</label>
+      <input id="email" name="email" type="email" autocomplete="email" required value="{{ email or '' }}" />
+
+      <label for="password">Password</label>
+      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
+
+      <label for="confirm_password">Confirm password</label>
+      <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required minlength="8" />
+
+      <button type="submit">Create account</button>
+    </form>
+
+    <p class="auth-switch">Already have an account? <a href="{{ url_for('login_page') }}">Log in</a></p>
+  </div>
+</body>
+</html>
