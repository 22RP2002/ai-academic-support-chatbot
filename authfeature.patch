+.auth-form input {
+  padding: 10px 12px;
+  border-radius: 10px;
+  border: 1px solid var(--panel-light);
+  background: #0f172a;
+  color: var(--text);
+  font-size: 14px;
+  outline: none;
+}
+
+.auth-form input:focus {
+  border-color: var(--accent-light);
+}
+
+.auth-form button {
+  margin-top: 10px;
+  background: var(--accent);
+  color: white;
+  border: none;
+  padding: 12px;
+  border-radius: 10px;
+  cursor: pointer;
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.auth-form button:hover {
+  background: var(--accent-light);
+}
+
+.auth-switch {
+  margin: 18px 0 0;
+  text-align: center;
+  font-size: 13px;
+  color: var(--text-dim);
+}
+
+.auth-switch a {
+  color: var(--accent-light);
+}
+
+.profile-fields {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 6px 14px;
+  margin: 0 0 16px;
+}
+
+.profile-fields dt {
+  font-size: 12px;
+  color: var(--text-dim);
+}
+
+.profile-fields dd {
+  margin: 0;
+  font-size: 14px;
+  color: var(--text);
+}
+
+.profile-note {
+  font-size: 12px;
+  color: var(--text-dim);
+  line-height: 1.5;
+  margin: 0 0 20px;
+}
+
+.auth-actions {
+  display: flex;
+  gap: 10px;
+}
+
+.auth-actions form {
+  margin: 0;
+  flex: 1;
+}
+
+.auth-actions .header-btn {
+  display: block;
+  width: 100%;
+  text-align: center;
+  text-decoration: none;
+  box-sizing: border-box;
+}
